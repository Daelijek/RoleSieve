# RoleSieve API — copy to `.env` in the repository root.
# Never commit real secrets.

# HeadHunter application token (Bearer access_token from https://dev.hh.ru/admin)
HH_TOKEN=

# Contact string required by HH API, same format as in the developer cabinet
ROLESIEVE_HH_USER_AGENT=RoleSieve/1.0 (you@email.com)

# Used only by scripts/hh_app_token.py to obtain HH_TOKEN
HH_CLIENT_ID=
HH_CLIENT_SECRET=

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Optional shared secret. If set, clients must send header X-API-Key
API_SHARED_KEY=

# Max vacancies processed per request / async job
HH_EXPORT_MAX_VACANCIES=100

# Optional Redis URL for RQ. If empty, jobs run in a background thread
ROLESIEVE_REDIS_URL=

LOG_LEVEL=INFO
